/* vbench_config.h — generated by CMake (configure_file) from vbench_config.h.in.
 * Do not edit; regenerate with: cmake -S . -B build
 * The legacy src/Makefile generates an equivalent file with the same name.
 *
 * Defines the SYS_* / ARCH_* / HAVE_* platform macros that the sources
 * previously got from -D flags on the compiler command line.
 * Included first by common.h and osdep.h.
 */
#ifndef VBENCH_CONFIG_H
#define VBENCH_CONFIG_H

/* ---- operating system ---- */
#define SYS_WINDOWS    @VBENCH_SYS_WINDOWS@
#define SYS_LINUX      @VBENCH_SYS_LINUX@
#define SYS_MACOSX     @VBENCH_SYS_MACOSX@
#define SYS_FREEBSD    @VBENCH_SYS_FREEBSD@
#define SYS_OPENBSD    @VBENCH_SYS_OPENBSD@
#define SYS_BEOS       @VBENCH_SYS_BEOS@
#define SYS_CYGWIN     @VBENCH_SYS_CYGWIN@
#define SYS_SunOS      @VBENCH_SYS_SUNOS@

/* ---- CPU architecture ---- */
#define ARCH_X86       @VBENCH_ARCH_X86@
#define ARCH_X86_64    @VBENCH_ARCH_X86_64@
#define ARCH_ARM       @VBENCH_ARCH_ARM@
#define ARCH_AARCH64   @VBENCH_ARCH_AARCH64@
#define ARCH_PPC       @VBENCH_ARCH_PPC@
#define ARCH_MIPS      @VBENCH_ARCH_MIPS@

/* ---- feature / asm availability ----
 * VBENCH_HAVE_ASM: architecture-specific assembly kernels are linked in.
 * HAVE_MMX: x86 inline/asm MMX+ kernels are available (x86 with asm only). */
#define VBENCH_HAVE_ASM @VBENCH_HAVE_ASM@
#define HAVE_X86_ASM    @VBENCH_HAVE_X86_ASM@
#define HAVE_MMX        @VBENCH_HAVE_MMX@
#define HAVE_NEON       @VBENCH_HAVE_NEON@
#define HAVE_ARMV6      @VBENCH_HAVE_ARMV6@
#define HAVE_ALTIVEC    @VBENCH_HAVE_ALTIVEC@
#define HAVE_MSA        @VBENCH_HAVE_MSA@
#define HAVE_THREAD     @VBENCH_HAVE_THREAD@
#define HAVE_POSIXTHREAD @VBENCH_HAVE_POSIXTHREAD@
#define HAVE_CPU_COUNT  @VBENCH_HAVE_CPU_COUNT@

/* ---- bit depth / stack ---- */
#define BIT_DEPTH       @VBENCH_BIT_DEPTH@
#define HIGH_BIT_DEPTH  @VBENCH_HIGH_BIT_DEPTH@
#define STACK_ALIGNMENT @VBENCH_STACK_ALIGNMENT@

#endif /* VBENCH_CONFIG_H */
